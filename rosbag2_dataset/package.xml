<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbag2_dataset</name>
  <version>0.1.0</version>
  <description>Indexed NumPy views of rosbag2 MCAP messages without ROS.</description>
  <maintainer email="ros-tooling@googlegroups.com">rosbag2 maintainers</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-lz4</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>rosbag2_storage_mcap</test_depend>
  <test_depend>rosidl_runtime_py</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>test_msgs</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
